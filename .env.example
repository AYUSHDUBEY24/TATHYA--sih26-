# =============================================================
# SIH26190 — Environment configuration (copy to `.env`, never commit .env)
# =============================================================

# --- Backend application ---
PROJECT_NAME="SIH26190 Secure Document Management System"
DEBUG=true
# JWT signing secret (Phase 2). Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-phase-2-0123456789abcdef-LOCAL-DEV-ONLY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated frontend origins allowed by backend CORS.
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL (matches docker/docker-compose.yml) ---
POSTGRES_USER=sih
POSTGRES_PASSWORD=sih_local_dev
POSTGRES_DB=sih26190
# SQLAlchemy connection string used by the FastAPI backend.
# Quick local dev without Docker: DATABASE_URL=sqlite:///./sih_dev.db
DATABASE_URL=postgresql+psycopg://sih:sih_local_dev@localhost:5432/sih26190

# --- MinIO object storage (actual document files) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=sih_local_dev
# Backend storage configuration (used by the FastAPI backend).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=sih_local_dev
MINIO_BUCKET=sih26190-documents
MINIO_SECURE=false
# "minio" (default, real backend) or "memory" (in-memory stub for local
# demos/tests without Docker — never use in any real environment).
STORAGE_BACKEND=minio

# --- Upload limits (Phase 4) ---
MAX_UPLOAD_SIZE_MB=50

# --- Blockchain (local Hardhat node only — added in Phase 7) ---
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
